+def synthetic_fetch_snapshot(current, stamp):
+    """Advance fetch bookkeeping without inventing publisher-site successes."""
+    from fetch_news_wire import generate_publisher_site_feeds, publisher_site_feed_due
+
+    wire = copy.deepcopy(current)
+    wire["generated_at"] = stamp.isoformat().replace("+00:00", "Z")
+    coverage = wire["feed_coverage"]
+    coverage["feeds_successful_this_run"] -= coverage["publisher_site_feeds_successful"]
+    coverage["publisher_site_feeds_successful"] = 0
+    coverage["publisher_site_feeds_due"] = sum(
+        publisher_site_feed_due(feed, stamp) for feed in generate_publisher_site_feeds()
+    )
+    coverage["feeds_due_this_run"] = (
+        coverage["direct_feeds"] + coverage["shared_discovery_feeds"]
+        + coverage["publisher_site_feeds_due"]
+    )
+    return wire
+
